<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft ambient drop shadow beneath the glass tile -->
    <item
        android:width="52dp"
        android:height="52dp"
        android:gravity="center"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#28060A1E" />
        </shape>
    </item>
    <item
        android:width="50dp"
        android:height="50dp"
        android:gravity="center"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#32060A1E" />
        </shape>
    </item>

    <!-- Frosted translucent glass tile with crisp specular rim -->
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="315"
                android:centerColor="#1CFFFFFF"
                android:endColor="#24BAE6FD"
                android:startColor="#48FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>

    <!-- Curved top-half glossy glass reflection -->
    <item
        android:width="45dp"
        android:height="21dp"
        android:gravity="center_horizontal|top"
        android:top="31dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp"
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#55FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Main icon artwork centered inside the glass tile -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/ic_launcher_art"
        android:gravity="center" />
</layer-list>
